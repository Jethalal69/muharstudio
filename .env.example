# ==============================================================================
# MUHAR STUDIO — Environment Configuration
# Copy this file to .env and provide your production or local secrets.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# Security & CORS Policy
# For production, set to your canonical domain (e.g., https://muharstudio.com)
ALLOWED_ORIGIN=*

# Admin Authentication (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=muhar_studio_2026!
ADMIN_SESSION_SECRET=change_this_to_a_random_32_char_secret_in_production

# Rate Limiting (Submissions per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Database Persistence
# Defaults to ./data/inquiries.db if left empty
DATABASE_PATH=./data/inquiries.db

# SMTP Email Configuration (Nodemailer)
# If left empty, notifications run in safe simulation mode (logged to server console).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Email Sender & Recipient
FROM_EMAIL="MUHAR STUDIO" <notifications@muharstudio.com>
NOTIFICATION_EMAIL=hello@muharstudio.com

# Retell AI Configuration (Voice AI Receptionist)
RETELL_API_KEY=
RETELL_AGENT_ID=
